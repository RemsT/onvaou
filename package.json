{
  "name": "onvaou",
  "version": "2.0.3",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "set-version": "node scripts/set-version.js",
    "enrich-elevation": "node scripts/enrich-trails-elevation.js",
    "build-content": "node scripts/build-content-db.js"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/(?!vector-icons)|@expo-google-fonts|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^expo-sqlite$": "<rootDir>/__mocks__/expo-sqlite.ts",
      "^expo-file-system/legacy$": "<rootDir>/__mocks__/expo-file-system-legacy.ts",
      "^expo-file-system$": "<rootDir>/__mocks__/expo-file-system-legacy.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/async-storage.ts",
      "/data/generatedFallback$": "<rootDir>/src/data/generatedFallback.ts"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "src/services/**/*.ts",
      "!src/services/locationService.ts"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.8",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/stack": "^7.4.9",
    "axios": "^1.12.2",
    "claude": "^0.1.2",
    "expo": "54.0.20",
    "expo-application": "~7.0.8",
    "expo-asset": "^12.0.9",
    "expo-checkbox": "^5.0.7",
    "expo-clipboard": "~8.0.7",
    "expo-file-system": "^19.0.17",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "^16.0.8",
    "expo-status-bar": "~3.0.8",
    "fflate": "^0.8.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "^1.20.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-webview": "13.15.0"
  },
  "private": true,
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^54.0.4",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.6.1",
    "jest-expo": "^55.0.18",
    "typescript": "~5.9.2"
  }
}
